# Required. Paths are deliberately not embedded in any script.
export MODEL_PATH=/models/DeepSeek-V4-Flash-0731
export DATASET_PATH=/datasets/ShareGPT_V3_unfiltered_cleaned_split.json

# Cluster-dependent settings.
export TP_SIZE=8
export HOST=127.0.0.1
export PORT=30000
export NUM_PROMPTS=100
# DeepSeek V4 requires the dsv4 attention backend, which deterministic inference
# does not currently support. Keep this at 0 until dsv4 joins SGLang's supported list.
export DETERMINISTIC_INFERENCE=0
# The bundled 0731 DSpark head uses gamma=5. Override only for an intentional sweep.
export DSPARK_BLOCK_SIZE=5
export HOST_TO_DEVICE_RATIO=5
# SM90 needs FlashInfer >= 0.6.11 with its mixed-input MXFP4 helpers.
export MOE_RUNNER_BACKEND=flashinfer_mxfp4
# Leave transient headroom for FlashInfer's fused-MoE workspace. Lower this
# further (for example, to 0.82) if the worker still runs out of memory.
export MEM_FRACTION_STATIC=0.85
# Reduce allocator fragmentation across variable-length requests. An existing
# cluster-specific value is preserved by run.sh.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Extra launch flags, for example quantization/MoE backend settings.
export SERVER_EXTRA_ARGS="--trust-remote-code"
