# Required paths (do not put machine-specific paths in the scripts).
export TARGET_MODEL_PATH=/path/to/DeepSeek-V4-Flash-0731
export DATASET_PATH=/path/to/ShareGPT_V3_unfiltered_cleaned_split.json
export DATASET_NAME=sharegpt

# Reproducible first-N ShareGPT sample.
export SAMPLE_COUNT=100
export SAMPLE_METHOD=first
export RANDOM_SEED=0
export MAX_NEW_TOKENS=256
export HOST=127.0.0.1
export PORT=30000
export TP_SIZE=8
export MOE_RUNNER_BACKEND=flashinfer_mxfp4
export HISPARSE_CONFIG='{"top_k":2048,"host_to_device_ratio":5}'
# Base results directory. This run writes to $RESULTS_DIR/dsv4_kv_residency.
# Omit it to use <repository>/results.
# export RESULTS_DIR=/custom/base/results
# Optional extra launch arguments, e.g. hardware-specific attention backends.
export SERVER_EXTRA_ARGS=''
